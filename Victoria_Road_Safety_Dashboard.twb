          <formatted-text>
            <run fontsize='12'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Vic_Road_Crash_Core_Dataset.csv+ (Multiple Connections)' name='federated.1qcrfay0jwb8ah11s9r8m17921sc' />
          </datasources>
          <datasource-dependencies datasource='federated.1qcrfay0jwb8ah11s9r8m17921sc'>
            <column caption='Accident Date' datatype='date' name='[ACCIDENT_DATE]' role='dimension' type='ordinal' />
            <column caption='Accident No' datatype='string' name='[ACCIDENT_NO]' role='dimension' type='nominal' />
            <column caption='Accident Time' datatype='datetime' name='[ACCIDENT_TIME]' role='dimension' type='ordinal' />
            <column caption='Age Group' datatype='string' name='[AGE_GROUP]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;5-Dec&quot;' value='5-12' />
              </aliases>
            </column>
            <column caption='Atmosph Cond Desc' datatype='string' name='[ATMOSPH_COND_DESC]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;Dust&quot;' value='Dusty' />
                <alias key='&quot;Fog&quot;' value='Foggy' />
                <alias key='&quot;Not known&quot;' value='Unknown' />
                <alias key='&quot;Raining&quot;' value='Rainy' />
                <alias key='&quot;Smoke&quot;' value='Smoky' />
                <alias key='&quot;Snowing&quot;' value='Snowy' />
                <alias key='&quot;Strong winds&quot;' value='Windy' />
              </aliases>
            </column>
            <column caption='Hour of Day' datatype='integer' name='[Calculation_1494913645317902339]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEPART(&apos;hour&apos;, [ACCIDENT_TIME])' />
            </column>
            <column caption='Day Type' datatype='string' name='[Calculation_1494913645324214276]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATEPART(&apos;weekday&apos;, [ACCIDENT_DATE]) IN (1,7) THEN &quot;Weekends&quot;&#13;&#10;ELSE &quot;Weekdays&quot; END' />
            </column>
            <column caption='Road User Group' datatype='string' name='[Calculation_1494913645815042068]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [ROAD_USER_TYPE_DESC] = &quot;Drivers&quot; THEN &quot;Drivers&quot;&#13;&#10;&#13;&#10;ELSEIF [ROAD_USER_TYPE_DESC] = &quot;Passengers&quot; THEN &quot;Passengers&quot;&#13;&#10;&#13;&#10;ELSEIF [ROAD_USER_TYPE_DESC] IN (&quot;Bicyclists&quot;, &quot;E-scooter Riders&quot;, &quot;Motorcyclists&quot;, &quot;Pillion Passengers&quot;)&#13;&#10;THEN &quot;Riders&quot;&#13;&#10;&#13;&#10;ELSEIF [ROAD_USER_TYPE_DESC] = &quot;Pedestrians&quot; THEN &quot;Pedestrians&quot;&#13;&#10;&#13;&#10;ELSE &quot;Other&quot;&#13;&#10;END' />
              <aliases>
                <alias key='&quot;Other&quot;' value='Other Users' />
              </aliases>
            </column>
            <column caption='Hour of Day Bins' datatype='string' name='[Calculation_1494913647476949013]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_1494913645317902339] &gt;= 5 AND [Calculation_1494913645317902339] &lt; 12 THEN &quot;Morning&quot;&#13;&#10;ELSEIF [Calculation_1494913645317902339] &gt;= 12 AND [Calculation_1494913645317902339] &lt; 17 THEN &quot;Afternoon&quot;&#13;&#10;ELSEIF [Calculation_1494913645317902339] &gt;= 17 AND [Calculation_1494913645317902339] &lt; 21 THEN &quot;Evening&quot;&#13;&#10;ELSE &quot;Night&quot;&#13;&#10;END' />
            </column>
            <column caption='Day Of Week' datatype='string' name='[DAY_OF_WEEK]' role='dimension' type='nominal' />
            <column caption='Inj Level Desc' datatype='string' name='[INJ_LEVEL_DESC]' role='dimension' type='nominal'>
              <aliases>
                <alias key='%null%' value='Unknown' />
                <alias key='&quot;Fatality&quot;' value='Fatal Injury' />
                <alias key='&quot;Not injured&quot;' value='No Injury' />
                <alias key='&quot;Other injury&quot;' value='Other Injury' />
                <alias key='&quot;Serious injury&quot;' value='Serious Injury' />
              </aliases>
            </column>
            <column caption='Lga Name' datatype='string' name='[LGA_NAME]' role='dimension' type='nominal' />
            <column caption='Road User Type Desc' datatype='string' name='[ROAD_USER_TYPE_DESC]' role='dimension' type='nominal' />
