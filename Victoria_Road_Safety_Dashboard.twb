      <column caption='ACCIDENT NO (road surface cond.csv)' datatype='string' name='[ACCIDENT_NO (road_surface_cond.csv)]' role='dimension' type='nominal' />
      <column caption='ACCIDENT NO (vehicle.csv)' datatype='string' name='[ACCIDENT_NO (vehicle.csv)]' role='dimension' type='nominal' />
      <column caption='Accident No' datatype='string' name='[ACCIDENT_NO]' role='dimension' type='nominal' />
      <column caption='Accident Time' datatype='datetime' name='[ACCIDENT_TIME]' role='dimension' type='ordinal' />
      <column caption='Accident Type' datatype='string' name='[ACCIDENT_TYPE]' role='dimension' type='nominal' />
      <column caption='Age Group' datatype='string' name='[AGE_GROUP]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;5-Dec&quot;' value='5-12' />
        </aliases>
      </column>
      <column caption='Atmosph Cond' datatype='integer' name='[ATMOSPH_COND]' role='measure' type='quantitative' />
      <column caption='Atmosph Cond Desc' datatype='string' name='[ATMOSPH_COND_DESC]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;Dust&quot;' value='Dusty' />
          <alias key='&quot;Fog&quot;' value='Foggy' />
          <alias key='&quot;Not known&quot;' value='Unknown' />
          <alias key='&quot;Raining&quot;' value='Rainy' />
          <alias key='&quot;Smoke&quot;' value='Smoky' />
          <alias key='&quot;Snowing&quot;' value='Snowy' />
          <alias key='&quot;Strong winds&quot;' value='Windy' />
        </aliases>
      </column>
      <column caption='Atmosph Cond Seq' datatype='integer' name='[ATMOSPH_COND_SEQ]' role='measure' type='quantitative' />
      <column caption='Bicyclist' datatype='integer' name='[BICYCLIST]' role='measure' type='quantitative' />
      <column caption='Carry Capacity' datatype='integer' name='[CARRY_CAPACITY]' role='measure' type='quantitative' />
      <column caption='Caught Fire' datatype='integer' name='[CAUGHT_FIRE]' role='measure' type='quantitative' />
      <column caption='Construction Type' datatype='string' name='[CONSTRUCTION_TYPE]' role='dimension' type='nominal' />
      <column caption='Country' datatype='string' name='[COUNTRY]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column caption='Cubic Capacity' datatype='integer' name='[CUBIC_CAPACITY]' role='measure' type='quantitative' />
      <column caption='Time String' datatype='string' name='[Calculation_1494913644007096320]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='RIGHT(&apos;0&apos; + STR(&#13;&#10;    IF DATEPART(&apos;hour&apos;, [ACCIDENT_TIME]) % 12 = 0 THEN 12&#13;&#10;    ELSE DATEPART(&apos;hour&apos;, [ACCIDENT_TIME]) % 12&#13;&#10;    END&#13;&#10;), 2)&#13;&#10;+ &apos;:&apos; +&#13;&#10;RIGHT(&apos;0&apos; + STR(DATEPART(&apos;minute&apos;, [ACCIDENT_TIME])), 2)&#13;&#10;+ &apos; &apos; +&#13;&#10;IF DATEPART(&apos;hour&apos;, [ACCIDENT_TIME]) &gt;= 12 THEN &apos;PM&apos; ELSE &apos;AM&apos; END' />
      </column>
      <column caption='Hour of Day' datatype='integer' name='[Calculation_1494913645317902339]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEPART(&apos;hour&apos;, [ACCIDENT_TIME])' />
      </column>
      <column caption='Day Type' datatype='string' name='[Calculation_1494913645324214276]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATEPART(&apos;weekday&apos;, [ACCIDENT_DATE]) IN (1,7) THEN &quot;Weekends&quot;&#13;&#10;ELSE &quot;Weekdays&quot; END' />
      </column>
      <column caption='Crash Count' datatype='integer' name='[Calculation_1494913645334704133]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([ACCIDENT_NO])' />
      </column>
      <column caption='Severity Numeric' datatype='integer' name='[Calculation_1494913645372162054]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [INJ_LEVEL]&#13;&#10;WHEN 1 THEN 3  // Fatality&#13;&#10;WHEN 2 THEN 2  // Serious Injury&#13;&#10;WHEN 3 THEN 1  // Other Injury&#13;&#10;WHEN 4 THEN 0  // Not Injured&#13;&#10;END' />
      </column>
      <column caption='Accidents per age group' datatype='integer' name='[Calculation_1494913645372841992]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([ACCIDENT_NO])' />
      </column>
      <column caption='Angle for Spokes' datatype='real' name='[Calculation_1494913645372993545]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INDEX() * (360 / SIZE())'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='X Coordinate' datatype='real' name='[Calculation_1494913645373104138]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1494913645372841992] * COS(RADIANS([Calculation_1494913645372993545]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Y coordinate' datatype='real' name='[Calculation_1494913645373304843]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1494913645372841992] * SIN(RADIANS([Calculation_1494913645372993545]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Road User Group' datatype='string' name='[Calculation_1494913645815042068]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [ROAD_USER_TYPE_DESC] = &quot;Drivers&quot; THEN &quot;Drivers&quot;&#13;&#10;&#13;&#10;ELSEIF [ROAD_USER_TYPE_DESC] = &quot;Passengers&quot; THEN &quot;Passengers&quot;&#13;&#10;&#13;&#10;ELSEIF [ROAD_USER_TYPE_DESC] IN (&quot;Bicyclists&quot;, &quot;E-scooter Riders&quot;, &quot;Motorcyclists&quot;, &quot;Pillion Passengers&quot;)&#13;&#10;THEN &quot;Riders&quot;&#13;&#10;&#13;&#10;ELSEIF [ROAD_USER_TYPE_DESC] = &quot;Pedestrians&quot; THEN &quot;Pedestrians&quot;&#13;&#10;&#13;&#10;ELSE &quot;Other&quot;&#13;&#10;END' />
        <aliases>
          <alias key='&quot;Other&quot;' value='Other Users' />
        </aliases>
      </column>
      <column caption='Hour of Day Bins' datatype='string' name='[Calculation_1494913647476949013]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1494913645317902339] &gt;= 5 AND [Calculation_1494913645317902339] &lt; 12 THEN &quot;Morning&quot;&#13;&#10;ELSEIF [Calculation_1494913645317902339] &gt;= 12 AND [Calculation_1494913645317902339] &lt; 17 THEN &quot;Afternoon&quot;&#13;&#10;ELSEIF [Calculation_1494913645317902339] &gt;= 17 AND [Calculation_1494913645317902339] &lt; 21 THEN &quot;Evening&quot;&#13;&#10;ELSE &quot;Night&quot;&#13;&#10;END' />
      </column>
      <column caption='Percent within road surface cond' datatype='real' name='[Calculation_1494913647477395478]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([ACCIDENT_NO]) / TOTAL(COUNT([ACCIDENT_NO])) * 100'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Road Name Display' datatype='string' name='[Calculation_2091077648200327168]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[ROAD_NAME] + &quot; &quot; + [ROAD_TYPE]' />
      </column>
      <column caption='LGA Filter' datatype='string' name='[Calculation_2091077648292786180]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;All&quot; THEN &quot;Show&quot;&#13;&#10;ELSEIF [LGA_NAME] = [Parameters].[Parameter 1] THEN &quot;Show&quot;&#13;&#10;ELSE &quot;Hide&quot;&#13;&#10;END' />
      </column>
      <column caption='Cluster Dynamic Title' datatype='string' name='[Calculation_2091077648298229766]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Crash Clusters Across &quot; +&#13;&#10;IF [Parameters].[Parameter 1] = &quot;All&quot; THEN &quot;Victoria&quot;&#13;&#10;ELSE [Parameters].[Parameter 1]&#13;&#10;END' />
      </column>
