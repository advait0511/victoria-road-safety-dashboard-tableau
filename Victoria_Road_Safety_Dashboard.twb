            <customized-tooltip>
              <formatted-text>
                <run bold='true' fontcolor='#000000' fontsize='14'>Crash Summary</run>
                <run>Æ&#10;&#10;</run>
                <run fontcolor='#000000'>On </run>
                <run bold='true' fontcolor='#000000'><![CDATA[<[federated.1qcrfay0jwb8ah11s9r8m17921sc].[attr:ACCIDENT_DATE:ok]> at <[federated.1qcrfay0jwb8ah11s9r8m17921sc].[attr:Calculation_1494913644007096320:nk]> (<[federated.1qcrfay0jwb8ah11s9r8m17921sc].[attr:DAY_OF_WEEK:nk]>)]]></run>
                <run fontcolor='#000000'>, an accident - </run>
                <run bold='true' fontcolor='#000000'><![CDATA[<[federated.1qcrfay0jwb8ah11s9r8m17921sc].[attr:ACCIDENT_TYPE:nk]>]]></run>
                <run fontcolor='#000000'> occurred (</run>
                <run bold='true' fontcolor='#000000'><![CDATA[<[federated.1qcrfay0jwb8ah11s9r8m17921sc].[attr:DCA_CODE_DESCRIPTION:nk]>]]></run>
                <run fontcolor='#000000'>).</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000'>The injury level was classified as </run>
                <run bold='true' fontcolor='#000000'><![CDATA[<[federated.1qcrfay0jwb8ah11s9r8m17921sc].[none:INJ_LEVEL_DESC:nk]>]]></run>
                <run fontcolor='#000000'>.</run>
                <run>Æ&#10;&#10;</run>
                <run fontcolor='#000000'>It happened at </run>
                <run bold='true' fontcolor='#000000'><![CDATA[<[federated.1qcrfay0jwb8ah11s9r8m17921sc].[attr:ROAD_NAME:nk]> <[federated.1qcrfay0jwb8ah11s9r8m17921sc].[attr:ROAD_TYPE:nk]>]]></run>
                <run fontcolor='#000000'>, in the </run>
                <run bold='true' fontcolor='#000000'><![CDATA[<[federated.1qcrfay0jwb8ah11s9r8m17921sc].[attr:LGA_NAME:nk]>]]></run>
                <run fontcolor='#000000'> area</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000'><![CDATA[(approx. coordinates: <[federated.1qcrfay0jwb8ah11s9r8m17921sc].[Latitude (generated)]>, <[federated.1qcrfay0jwb8ah11s9r8m17921sc].[Longitude (generated)]>).]]></run>
                <run>Æ&#10;&#10;</run>
                <run fontcolor='#000000'>Road conditions: </run>
                <run bold='true' fontcolor='#000000'><![CDATA[<[federated.1qcrfay0jwb8ah11s9r8m17921sc].[attr:ROAD_GEOMETRY:nk]>]]></run>
                <run fontcolor='#000000'> on a </run>
                <run bold='true' fontcolor='#000000'><![CDATA[<[federated.1qcrfay0jwb8ah11s9r8m17921sc].[attr:SURFACE_COND_DESC:nk]>]]></run>
                <run fontcolor='#000000'> road surface with a speed zone of </run>
                <run bold='true' fontcolor='#000000'><![CDATA[<[federated.1qcrfay0jwb8ah11s9r8m17921sc].[attr:SPEED_ZONE:nk]>]]></run>
                <run fontcolor='#000000'>, under </run>
                <run bold='true' fontcolor='#000000'><![CDATA[<[federated.1qcrfay0jwb8ah11s9r8m17921sc].[attr:LIGHT_CONDITION:nk]>]]></run>
                <run fontcolor='#000000'> lighting.</run>
